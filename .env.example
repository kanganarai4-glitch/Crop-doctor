# ─────────────────────────────────────────────────────────────────────────────
# CropDoctor — .env.example
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────────
NODE_ENV=development

# ── API ───────────────────────────────────────────────────────────
PORT=3001

# A strong random secret for signing JWTs (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET
JWT_EXPIRY=30d

# ── MongoDB ───────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/cropdoctor
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/cropdoctor?retryWrites=true

# ── FastAPI Inference Service ─────────────────────────────────────
INFERENCE_SERVICE_URL=http://localhost:8000
# In Docker Compose this is: http://inference:8000

# ── Model ─────────────────────────────────────────────────────────
# Current TFLite model version served to the PWA
MODEL_VERSION=0.0.1-dummy
# S3 URL for the browser to download the TFLite model
TFLITE_MODEL_S3_URL=https://your-bucket.s3.ap-south-1.amazonaws.com/models/mobilenet_dummy.tflite

# Confidence threshold below which we return "uncertain" status
LOW_CONFIDENCE_THRESHOLD=0.60

# ── AWS ───────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=cropdoctor-images
S3_PREFIX=scans

# ── Bhashini ─────────────────────────────────────────────────────
# Register at https://bhashini.gov.in to get credentials
BHASHINI_USER_ID=REPLACE_ME
BHASHINI_API_KEY=REPLACE_ME
# TODO: Confirm exact endpoint URLs from Bhashini developer portal
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_COMPUTE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Supported language codes (comma-separated)
SUPPORTED_LANGUAGES=en,hi,mr,ta,te,bn,kn

# ── ML Inference Service (for docker-compose / local run) ─────────
MAX_IMAGE_SIZE_MB=10

# ── CI/CD (GitHub Actions — set as Secrets, not here) ────────────
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/GitHubActionsDeployRole
# ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
# ECS_CLUSTER=cropdoctor-cluster
